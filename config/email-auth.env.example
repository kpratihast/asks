# Server environment only. Never commit your real SMTP password.
# Brevo Free SMTP: create a Brevo account, verify a sender, then generate an SMTP key.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=your-brevo-smtp-login
SMTP_PASSWORD=your-brevo-smtp-key
SMTP_FROM="Ask IISc <your-verified-sender@example.com>"

# Required in production behind HTTPS. The local launcher defaults to 0 for loopback HTTP.
AUTH_COOKIE_SECURE=1
# Public URL of the app, without a trailing slash, when running behind a reverse proxy.
# AUTH_PUBLIC_ORIGIN=https://your-app.example.com
# AUTH_DB_PATH=/persistent/private/auth/sessions.sqlite3
# FACULTY_DIRECTORY=/path/to/config/faculty_directory.json
# For remote retrieval, set the same private credential on gateway and retrieval service.
# RETRIEVAL_SERVICE_KEY=generate-a-long-random-private-key

# Email OTP/user validation feature flag. 0 = public-only mode, no privileged access.
EMAIL_AUTH_ENABLED=1
# Optional exact-address professor test override; empty by default.
# AUTH_PROFESSOR_TEST_EMAILS=your-test-address@iisc.ac.in
